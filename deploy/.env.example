# 复制为 deploy/.env 后按需修改；.env 不入库。
# 端口留空则用 docker-compose.yml 里的默认值。

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=agent_platform
MYSQL_USER=app
MYSQL_PASSWORD=apppass
MYSQL_PORT=13306

# Redis
REDIS_PORT=16379

# RustFS（S3 兼容对象存储）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# 应用
SERVER_PORT=8080
AUTH_PORT=8081
WEB_PORT=8088
