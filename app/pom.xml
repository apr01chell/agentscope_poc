<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.agentscope.platform</groupId>
  <artifactId>agent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>agent-platform</name>
  <description>多用户云端 Agent 平台：工作台后端与用户中心</description>

  <modules>
    <module>common</module>
    <module>server</module>
    <module>auth</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <agentscope.version>2.1.0-BETA1</agentscope.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        AgentScope Java 锁在 2.1.0-BETA1：产物 SPI 依赖 2.1 才有的 SandboxFileTransfer。
        不用自建 SNAPSHOT（构建时会因 test-jar 依赖失败）。
      -->
      <dependency>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-harness</artifactId>
        <version>${agentscope.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-extensions-model-openai</artifactId>
        <version>${agentscope.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
