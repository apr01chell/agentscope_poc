# 前端环境变量示例。复制为 .env.local 后按需修改；`.env.local` 不入库。

# 应用标题，会写入 document.title 并显示在顶栏与登录页。
VITE_APP_TITLE=前端基础模板

# 接口基础地址。留空时请求走相对路径 /api，由 Vite 代理转发到本地后端；
# 部署到独立域名时再填完整地址（如 https://api.example.com）。
VITE_API_BASE_URL=

# 请求超时（毫秒）。
VITE_API_TIMEOUT=15000

# 是否使用内置认证 Mock（src/mock/auth.ts）。默认开启，让新项目与 AI 测试开箱即跑；
# 接入真实后端后设为 false。
VITE_USE_MOCK=true
