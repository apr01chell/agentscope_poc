# 默认环境变量（入库）。
#
# 这里放「所有环境都成立、且不敏感」的默认值；个人覆盖写进 `.env.local`（已被 .gitignore 忽略）。
# Vite 的加载优先级：.env.local > .env.[mode].local > .env.[mode] > .env
#
# 变量说明见 .env.example。

VITE_APP_TITLE=Agent 工作台
VITE_API_BASE_URL=
VITE_API_TIMEOUT=15000
# 后端 origin。留空表示同源（nginx 反代）；dev 在 .env.development 里指向 8080
VITE_SERVER_ORIGIN=
VITE_USE_MOCK=true
